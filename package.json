{
  "name": "wearlog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/version-assets.mjs && npm run db:local && cf dev",
    "build": "node scripts/version-assets.mjs && cf build",
    "deploy": "cf deploy",
    "types": "cf workers types",
    "test": "node --test tests/model.test.js tests/worker.test.js",
    "test:browser": "python tests/browser_check.py",
    "db:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --mode development --dir migrations",
    "screenshots": "python scripts/screenshots.py",
    "test:updates": "python tests/update_check.py"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@types/node": "26.6.6",
    "cf": "1.0.0-rc.1",
    "miniflare": "5.20261117.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "jose": "6.2.17",
    "qrcode-generator": "2.0.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Photo-first garment wear and wash tracking with offline logging and automatic sync."
}
